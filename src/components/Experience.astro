---

<ol class="relative">
  {
    EXPERIENCE.map((experience) => (
      <li
        id={
          experience.company === "CodeArts Solutions" ? "codearts" : undefined
        }
        class="scroll-mt-32"
      >
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
