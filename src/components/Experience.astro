  },
  {
    dateEs: "Ene 2025 - Ene 2026",
    dateEn: "Jan 2025 – Jan 2026",
    titleEs: "Programador Full Stack | Project Manager",
    titleEn: "Full-Stack Developer | Project Manager",
    company: "CodeArts Solutions",
    descriptionEs:
      "Desarrollo en proyectos reales de cliente, combinado con la tutorización de desarrolladores en prácticas. Gestión de sprints, organización de tareas y revisión de código.",
