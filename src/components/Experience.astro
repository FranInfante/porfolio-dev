---
const NOW = [
  {
    dateEs: "Oct 2024 - Presente",
    dateEn: "Oct 2024 – Present",
    titleEs: "Fundador · Soluciones digitales para empresas",
    titleEn: "Founder · Digital solutions for businesses",
    company: "RepsDown S.L.",
    descriptionEs:
      "Mi sociedad para proyectos de clientes. Hago webs, apps móviles, automatizaciones e IA para negocios de inmobiliaria, hostelería, eventos y servicios: desde la primera reunión hasta tenerlo funcionando y mantenerlo. Producto propio: RepsDown, una app de entrenamiento en App Store y Google Play con un asistente de IA que trabaja sobre datos reales.",
    descriptionEn:
      "My company for client projects. I build websites, mobile apps, automations and AI for real estate, hospitality, events and service businesses: from the first meeting to having it live and maintained. Own product: RepsDown, a training app on the App Store and Google Play with an AI assistant that works on real data.",
    link: "https://repsdown.com",
  },
  {
    dateEs: "Ene 2026 - Presente",
    dateEn: "Jan 2026 – Present",
    titleEs: "Consultor de Transformación Digital | PMO",
    titleEn: "Digital Transformation Consultant | PMO",
    company: "MIGSO-PCUBED",
    descriptionEs:
      "Creo herramientas internas con el equipo de Transformación Digital para Consultoría y RRHH, y coordino el desarrollo: planificación, prioridades y entregas a tiempo con metodologías ágiles.",
    descriptionEn:
      "I build internal tools with the Digital Transformation team for Consulting and HR, and coordinate development: planning, priorities and on-time delivery with agile methods.",
  },
];

const BEFORE = [
  {
    id: "codearts",
    dateEs: "Ene 2025 - Ene 2026",
    dateEn: "Jan 2025 – Jan 2026",
    company: "CodeArts Solutions",
    textEs: "Programador full-stack y jefe de proyecto en proyectos de cliente; tutor de desarrolladores en prácticas.",
    textEn: "Full-stack developer and project manager on client projects; mentor to junior developers.",
  },
  {
    dateEs: "Nov 2024 - Ene 2025",
    dateEn: "Nov 2024 – Jan 2025",
    company: "Diseloo Technologies",
    textEs: "BoxFirma: emisión de certificados digitales para administradores de fincas.",
    textEn: "BoxFirma: digital certificate issuing for property managers.",
  },
  {
    dateEs: "Sep 2024 - Nov 2024",
    dateEn: "Sep 2024 – Nov 2024",
    company: "Proyectos voluntarios",
    companyEn: "Volunteer projects",
    textEs: "Petinder y Stars League Fantasy (están en Proyectos).",
    textEn: "Petinder and Stars League Fantasy (see Projects).",
  },
  {
    dateEs: "Mar 2024 - Jun 2024",
    dateEn: "Mar 2024 – Jun 2024",
    company: "Profile Software Services",
    textEs: "Prácticas de programador full-stack: reservas de salas y gestión de una autoescuela.",
    textEn: "Full-stack internship: meeting-room booking and a driving school manager.",
  },
];
---

<div class="mx-4 md:mx-8 flex flex-col gap-8">
  <div>
    <h3 class="text-sm uppercase tracking-widest text-white/60 font-semibold mb-3">
      <span class="i18n-es">Ahora</span>
      <span class="i18n-en">Now</span>
    </h3>
    <ul class="grid gap-4 md:grid-cols-2">
      {
        NOW.map((e) => (
          <li class="flex flex-col gap-2 rounded-xl border border-white/10 bg-slate-900/40 p-5 shadow-[0_18px_45px_rgba(15,23,42,0.65)]">
            <h4 class="text-xl font-bold text-white">{e.company}</h4>
            <p class="font-semibold text-blue-300">
              <span class="i18n-es">{e.titleEs}</span>
              <span class="i18n-en">{e.titleEn}</span>
            </p>
            <time class="text-sm text-white/70">
              <span class="i18n-es">{e.dateEs}</span>
              <span class="i18n-en">{e.dateEn}</span>
            </time>
            <p class="text-white/90 i18n-es">{e.descriptionEs}</p>
            <p class="text-white/90 i18n-en">{e.descriptionEn}</p>
            {e.link && (
              <a href={e.link} target="_blank" rel="noopener" class="text-cyan-300 underline mt-auto">
                {e.link.replace("https://", "")}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <h3 class="text-sm uppercase tracking-widest text-white/60 font-semibold mb-3">
      <span class="i18n-es">Antes</span>
      <span class="i18n-en">Before</span>
    </h3>
    <ol class="flex flex-col divide-y divide-white/10 rounded-xl border border-white/10 bg-slate-900/30">
      {
        BEFORE.map((e) => (
          <li id={e.id} class="scroll-mt-32 grid gap-1 p-4 md:grid-cols-[180px_1fr] md:gap-4">
            <time class="text-sm text-white/60">
              <span class="i18n-es">{e.dateEs}</span>
              <span class="i18n-en">{e.dateEn}</span>
            </time>
            <p>
              <span class="font-semibold text-white">
                <span class="i18n-es">{e.company}</span>
                <span class="i18n-en">{e.companyEn ?? e.company}</span>
              </span>
              <span class="text-white/80"> · </span>
              <span class="text-white/80 i18n-es">{e.textEs}</span>
              <span class="text-white/80 i18n-en">{e.textEn}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</div>
