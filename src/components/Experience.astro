  {
    dateEs: "Nov 2024 - Ene 2025",
    dateEn: "Nov 2024 – Jan 2025",
    titleEs: "BoxFirma",
    titleEn: "BoxFirma",
    company: "Diseloo Technologies",
    descriptionEs:
      "Producto de gestión y emisión de certificados digitales para clientes gestores y administradores de fincas.",
    descriptionEn:
      "Product for managing and issuing digital certificates for property managers and administrators.",
  },
  {
