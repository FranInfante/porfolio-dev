---
import GithubIcon from "./icons/GithubIcon.astro";
import LinkButton from "./LinkButton.astro";
import SpringbootIcon from "./icons/SpringbootIcon.astro";
import AngularIcon from "./icons/AngularIcon.astro";
import JavaIcon from "./icons/JavaIcon.astro";
import HTMLIcon from "./icons/HTMLIcon.astro";
import CSSIcon from "./icons/CSSIcon.astro";
import BootstrapIcon from "./icons/BootstrapIcon.astro";
import TypeScriptIcon from "./icons/TypeScriptIcon.astro";
import PostmanIcon from "./icons/PostmanIcon.astro";
import JWTIcon from "./icons/JWTIcon.astro";
import NextIcon from "./icons/NextIcon.astro";
import TailwindIcon from "./icons/TailwindIcon.astro";
import MongoIcon from "./icons/MongoIcon.astro";
import ReactIcon from "./icons/ReactIcon.astro";
import FirebaseIcon from "./icons/FirebaseIcon.astro";
import JestIcon from "./icons/JestIcon.astro";
import NestIcon from "./icons/NestIcon.astro";
import PostgresIcon from "./icons/PostgresIcon.astro";

const TAGS = {
  FirebaseIcon: {
    name: "Firebase",
    class: "border text-white",
    icon: FirebaseIcon,
  },
  JestIcon: {
    name: "Jest",
    class: "border text-white",
    icon: JestIcon,
  },
  SpringbootIcon: {
    name: "Spring Boot",
    class: "border text-white",
    icon: SpringbootIcon,
  },
  NextIcon: {
    name: "Next",
    class: "border text-white",
    icon: NextIcon,
  },
  ReactIcon: {
    name: "React",
    class: "border text-white",
    icon: ReactIcon,
  },
  MongoIcon: {
    name: "MongoDB",
    class: "border text-white",
    icon: MongoIcon,
  },
  NestIcon: {
    name: "NestJS",
    class: "border text-white",
    icon: NestIcon,
  },
  PostgresIcon: {
    name: "PostgreSQL",
    class: "border text-white",
    icon: PostgresIcon,
  },
  TailwindIcon: {
    name: "Tailwind",
    class: "border text-white",
    icon: TailwindIcon,
  },
  Angular: {
    name: "Angular",
    class: "border text-white",
    icon: AngularIcon,
  },
  Java: {
    name: "Java",
    class: "border text-white",
    icon: JavaIcon,
  },
  HTML: {
    name: "HTML",
    class: "border text-white",
    icon: HTMLIcon,
  },
  CSS: {
    name: "CSS",
    class: "border text-white",
    icon: CSSIcon,
  },
  Bootstrap: {
    name: "Bootstrap",
    class: "border text-white",
    icon: BootstrapIcon,
  },
  TypeScript: {
    name: "TypeScript",
    class: "border text-white",
    icon: TypeScriptIcon,
  },
  Postman: {
    name: "Postman",
    class: "border text-white",
    icon: PostmanIcon,
  },
  JWT: {
    name: "JWT",
    class: "border text-white",
    icon: JWTIcon,
  },
};
const PROJECTS = [
  {
    title: "RepsDown",
    descriptionEs:
      "Plataforma de entrenamiento que fundé y sigo operando yo solo, disponible en web, App Store y Google Play. Cliente web en Angular 21, app móvil en React Native, API en Spring Boot 3.4 sobre Java 21 y PostgreSQL 17, con Docker y GitHub Actions ejecutando 137 tests y desplegando a staging en cada push. Su asistente de IA usa respuestas de esquema forzado, fallback a un modelo más ligero con backoff exponencial y validación en base de datos de cada ID que devuelve el modelo, para que no pueda inventarse un registro.",
    descriptionEn:
      "Training platform I founded and still run on my own, live on the web, the App Store and Google Play. Angular 21 web client, React Native mobile app, a Spring Boot 3.4 API on Java 21 and PostgreSQL 17, with Docker and GitHub Actions running 137 tests and deploying to staging on every push. Its AI assistant uses schema-constrained responses, fallback to a lighter model with exponential backoff, and database validation of every model-returned ID so it cannot invent a record.",
    url: "https://repsdown.com",
    image: "/projects/repsdown.webp",
    tags: [
      TAGS.Angular,
      TAGS.ReactIcon,
      TAGS.TypeScript,
      TAGS.Java,
      TAGS.SpringbootIcon,
      TAGS.PostgresIcon,
    ],
  },
  {
    title: "Centralit.IA y Secretar.IA",
    descriptionEs:
      "Apps móviles de Iberika Telecom para pymes: Centralit.IA hace del móvil una extensión más de la centralita y Secretar.IA es una secretaria virtual con la que el dueño habla por chat o por voz. Soy el desarrollador principal de la app: React Native con un módulo nativo en Kotlin para que la llamada suene con la app cerrada (FCM, Core-Telecom y registro SIP), vinculación con un QR del panel, audio WebRTC arreglado con re-INVITE e importación de contactos en lotes. En el servidor construyo los recados, citas y encargos de llamada que la IA gestiona sola.",
    descriptionEn:
      "Iberika Telecom's mobile apps for small businesses: Centralit.IA turns a phone into one more PBX extension and Secretar.IA is a virtual secretary the owner talks to by chat or voice. I'm the app's lead developer: React Native with a native Kotlin module so calls ring with the app closed (FCM, Core-Telecom and SIP registration), pairing through a QR code from the dashboard, WebRTC audio fixed with re-INVITE, and batched contact import. On the server I build the messages, appointments and call tasks the AI handles on its own.",
    image: "/projects/secretaria.webp",
    imageContain: true,
    tags: [TAGS.ReactIcon, TAGS.TypeScript],
  },
  {
    title: "CRS Real Estate",
    descriptionEs:
      "Web para una consultora inmobiliaria de Miami que convierte visitas en contactos: fichas de propiedades con galerías, sección internacional, formularios y un panel con la gráfica de visitas y el embudo de los envíos por correo. Frontend en Angular 20 y API en NestJS con PostgreSQL, todo en Docker Compose con entornos de preproducción y producción.",
    descriptionEn:
      "Website for a Miami real estate consultancy that turns visits into leads: property listings with galleries, an international section, lead forms and a dashboard with a visits chart and an email campaign funnel. Angular 20 frontend and a NestJS API on PostgreSQL, all in Docker Compose with pre-production and production environments.",
    url: "https://crsreconsultants.com",
    image: "/projects/crsre.webp",
    tags: [TAGS.Angular, TAGS.TypeScript, TAGS.NestIcon, TAGS.PostgresIcon],
  },
  {
    title: "Bolas: El Juego",
    descriptionEs:
      "Juego cooperativo de gestión al estilo Overcooked ambientado en Heladerías Bolas (Sevilla). De 1 a 4 jugadores en local con mando o teclado, o en línea entre navegadores. Escena 3D en Three.js con Vite y TypeScript, multijugador P2P con PeerJS y una pequeña API para perfiles y salas.",
    descriptionEn:
      "Overcooked-style co-op management game set in Heladerías Bolas, an ice cream shop in Seville. 1 to 4 players locally with gamepad or keyboard, or online between browsers. 3D scene in Three.js with Vite and TypeScript, peer-to-peer multiplayer with PeerJS and a small API for profiles and rooms.",
    image: "/projects/bolas-game.webp",
    tags: [TAGS.TypeScript, TAGS.HTML, TAGS.CSS],
  },
  {
    title: "Bóveda",
    descriptionEs:
      "Gestor de contraseñas propio para no depender de uno de terceros. Todo se cifra en el navegador (AES-GCM 256, PBKDF2 con 600.000 iteraciones) y el servidor solo guarda texto cifrado en Redis; detecta guardados simultáneos desde dos dispositivos para no pisar datos y conserva la versión anterior. Desbloqueo con Face ID por WebAuthn PRF sin guardar la contraseña maestra, contraseñas que se copian sin mostrarse y se borran del portapapeles a los 30 s, y un asistente de IA al que nunca le llegan las contraseñas. Además guarda documentos y abre el garaje desde Siri.",
    descriptionEn:
      "My own password manager, so I don't depend on a third-party one. Everything is encrypted in the browser (AES-GCM 256, PBKDF2 with 600,000 iterations) and the server only stores ciphertext in Redis; it detects simultaneous saves from two devices so no data is overwritten, and keeps the previous version. Face ID unlock via WebAuthn PRF without storing the master password, passwords copied without being shown and cleared from the clipboard after 30 s, and an AI assistant that never sees a password. It also stores documents and opens the garage from Siri.",
    image: "/projects/boveda.webp",
    tags: [TAGS.HTML, TAGS.CSS],
  },
  {
    title: "Tricount RepsDown",
    descriptionEs:
      "Facturación y contabilidad para que una pequeña empresa o un autónomo lleve facturas, gastos, IVA y calendario fiscal sin gestoría. Las facturas cumplen VERI*FACTU (huella encadenada, XML, QR y envío a la AEAT con certificado, con reintentos). Lee el banco por PSD2 y concilia solo cada movimiento con su factura o gasto; una foto de un tique se convierte en un gasto rellenado por IA y archivado en Drive; y avisa de cada obligación fiscal antes de que venza. Cada cobro se reparte automáticamente entre las cajas de los socios. PHP 8.2 y MySQL, con API firmada con HMAC y servidor MCP para que otras apps y agentes emitan facturas.",
    descriptionEn:
      "Invoicing and bookkeeping so a small business or freelancer can handle invoices, expenses, VAT and the tax calendar without an accountant. Invoices comply with Spain's VERI*FACTU (chained hash, XML, QR and submission to the tax agency with a client certificate, with retries). It reads the bank through PSD2 and reconciles each transaction with its invoice or expense on its own; a photo of a receipt becomes an AI-filled expense filed in Drive; and it warns about every tax deadline before it's due. Each payment is split automatically between the partners' accounts. PHP 8.2 and MySQL, with an HMAC-signed API and an MCP server so other apps and agents can issue invoices.",
    image: "/projects/tricount.webp",
    tags: [],
  },
  {
    title: "Fichaje",
    descriptionEs:
      "Tenía que fichar en Woffu cuatro veces al día; ahora lo hace una rutina por mí. Ficha según mi horario y el modo de cada día (casa, oficina o cliente), cuadra la jornada de 8 horas ajustando la vuelta de comer y deja cada fichaje o fallo en avisos. La PWA, en JavaScript sin framework, enseña el estado del día, la semana y los próximos cambios, y un chat con Claude entiende frases como «el lunes no ficho» y propone el cambio. Un Cloudflare Worker guarda el token de Woffu y los datos viven como JSON versionado con control de concurrencia.",
    descriptionEn:
      "I had to clock in on Woffu four times a day; now a routine does it for me. It clocks in following my schedule and each day's mode (home, office or client), balances the 8-hour day by adjusting the lunch return, and logs every clock-in or failure as an alert. The PWA, in plain JavaScript, shows today's status, the week and upcoming changes, and a Claude-powered chat understands sentences like \"I'm off on Monday\" and proposes the change. A Cloudflare Worker holds the Woffu token and the data lives as versioned JSON with concurrency control.",
    image: "/projects/fichaje.webp",
    tags: [TAGS.HTML, TAGS.CSS],
  },
  {
    title: "Santuario",
    descriptionEs:
      "Web para El Santuario Recording Studio con landing, fichas de Estudio A/B/C, servicios y contacto, con experiencia multilenguaje. Frontend en Angular 20 con TailwindCSS y backend NestJS 11 listo para crecer con PostgreSQL y Docker Compose.",
    descriptionEn:
      "Website for El Santuario Recording Studio featuring a landing page, Studio A/B/C detail pages, services and contact, with a multilingual experience. Built with Angular 20 + TailwindCSS and a NestJS 11 backend scaffolded for PostgreSQL and Docker Compose.",
    url: "https://elsantuariorecording.com",

    image: "/projects/santuario2025.webp",
    tags: [
      TAGS.Angular,
      TAGS.TypeScript,
      TAGS.TailwindIcon,
      TAGS.NestIcon,
      TAGS.PostgresIcon,
    ],
  },
  {
    title: "LouBooking",
    descriptionEs:
      "LouBooking es una plataforma web ligera para gestionar las reservas de un tatuador. Los clientes pueden consultar las jornadas disponibles y enviar solicitudes de cita sin necesidad de registrarse, mientras que el tatuador gestiona todas las peticiones desde un panel de administración protegido, aceptando o rechazando solicitudes y evitando dobles reservas al bloquear automáticamente los huecos confirmados. El proyecto está desarrollado con Angular 20 y TailwindCSS en el frontend, NestJS 11 con PostgreSQL y TypeORM en el backend, y se despliega en un VPS mediante Docker Compose.",
    descriptionEn:
      "LouBooking is a lightweight booking platform for tattoo artists. Clients can browse available sessions and request appointments without creating an account, while the artist manages requests from a secure admin panel that prevents double bookings by blocking confirmed time slots. It is built with Angular 20 and TailwindCSS on the frontend, NestJS 11 with PostgreSQL and TypeORM on the backend, and deployed on a VPS using Docker Compose.",
    url: "https://loubooking.com",
    image: "/projects/loubooking.webp",
    tags: [
      TAGS.Angular,
      TAGS.TypeScript,
      TAGS.TailwindIcon,
      TAGS.NestIcon,
      TAGS.PostgresIcon,
    ],
  },
  {
    title: "Petinder",
    descriptionEs:
      "Plataforma dedicada principalmente a dar visibilidad a las protectoras de animales con el objetivo de aumentar las adopciones, educar a los usuarios sobre la adopción responsable y reducir el abandono. Además, ofrece una amplia variedad de actividades, lugares para visitar y experiencias de viaje, brindando a los usuarios diversas opciones para disfrutar con sus mascotas.",
    descriptionEn:
      "Platform focused on giving visibility to animal shelters to increase adoptions, educate users about responsible adoption and reduce abandonment. It also offers activities, places to visit and travel ideas so people can enjoy more plans with their pets.",
    image: "/projects/petinder.webp",
    tags: [
      TAGS.NextIcon,
      TAGS.TypeScript,
      TAGS.TailwindIcon,
      TAGS.MongoIcon,
      TAGS.ReactIcon,
    ],
  },
  {
    title: "Stars League Fantasy",
    descriptionEs:
      "Stars League Fantasy es una aplicación de fantasía para entusiastas del fútbol, en la que los usuarios pueden crear equipos virtuales y competir en función de los resultados reales de sus jugadores seleccionados. Mi rol en este proyecto se centró en el desarrollo y mantenimiento del backend, donde realicé pruebas exhaustivas con Jest para asegurar la funcionalidad y consistencia de las características implementadas.",
    descriptionEn:
      "Stars League Fantasy is a fantasy football app where users build virtual teams and compete based on the real‑world performance of their players. My role focused on backend development and maintenance, writing thorough Jest tests to guarantee stability and reliability.",
    image: "/projects/starsleague.webp",
    tags: [TAGS.JestIcon, TAGS.TypeScript, TAGS.FirebaseIcon],
  },
  {
    title: "FranOnWheels",
    descriptionEs:
      "Primer proyecto adaptándome a nuevas tecnologías y lenguajes, aplicación destinada a la gestión automatizada de una autoescuela, tratando con usuarios, reserva de clases, vehículos y facilidad en control de datos sin necesidad de entrar al código.",
    descriptionEn:
      "My first full project exploring new technologies and languages: a management app for a driving school, handling users, class bookings and vehicles to simplify daily operations without touching the code.",
    github: "https://github.com/FranInfante/FranOnWheelsApp",
    image: "/projects/FranOnWheels.webp",
    tags: [
      TAGS.SpringbootIcon,
      TAGS.Java,
      TAGS.Angular,
      TAGS.TypeScript,
      TAGS.HTML,
      TAGS.CSS,
      TAGS.Bootstrap,
      TAGS.Postman,
      TAGS.JWT,
    ],
  },
  {
    title: "Profile Rooms",
    descriptionEs:
      "Proyecto que llevamos a delante en el equipo de Profile Software Services para permitir a personas ajenas a la empresa reservar salas disponibles, aquí aprendí a gestionar control de versiones dentro de un equipo profesional, afianzando lo ya aprendido y leyendo documentación con aspectos desconocidos de la programación.",
    descriptionEn:
      "Project developed with the team at Profile Software Services to let external users book available meeting rooms. I learned how to work with version control in a professional environment, consolidating what I already knew and diving into documentation for unfamiliar topics.",
    github: "https://github.com/FranInfante/ProfileRooms",
    image: "/projects/Rooms.webp",
    tags: [
      TAGS.SpringbootIcon,
      TAGS.Java,
      TAGS.Angular,
      TAGS.TypeScript,
      TAGS.HTML,
      TAGS.CSS,
      TAGS.Bootstrap,
      TAGS.Postman,
      TAGS.JWT,
    ],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(
      ({ image, imageContain, title, descriptionEs, descriptionEn, tags, github, url }) => (
        <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
          <div class="w-full md:w-1/2">
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform overflow-clip rounded-xl sm:rounded-xl group-hover:-translate-y-2">
              <img
                alt={`${title} screenshot`}
                class={imageContain
                  ? "w-full max-h-80 object-contain bg-slate-900 p-10 transition duration-500 group-hover:scale-105"
                  : "object-cover object-top w-full h-auto transition duration-500 sm:h-full md:scale-110 group-hover:scale-105"}
                src={image}
              />
            </div>
          </div>

          <div class="w-full md:w-1/2 md:max-w-lg">
            <h3 class="text-2xl font-bold text-white-800 dark:text-gray-100">
              {title}
            </h3>
            <div class="flex flex-wrap mt-2">
              <ul class="flex flex-row mb-2 gap-x-2 flex-wrap">
                {tags.map((tag) => (
                  <li class="pb-2">
                    <span
                      class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                    >
                      <tag.icon class="size-4" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="mt-2 text-white-700 opacity-85 dark:text-gray-400">
                <p class="i18n-es">{descriptionEs}</p>
                <p class="i18n-en">{descriptionEn}</p>
              </div>
              <footer class="flex items-center justify-center w-full md:justify-start mt-4 gap-x-4">
                {url && (
                  <LinkButton href={url}>
                    <span class="i18n-es">Ver proyecto</span>
                    <span class="i18n-en">View project</span>
                  </LinkButton>
                )}
                {github && (
                  <LinkButton href={github}>
                    <GithubIcon class="size-6" />
                    <span class="i18n-es">Código</span>
                    <span class="i18n-en">Source</span>
                  </LinkButton>
                )}
              </footer>
            </div>
          </div>
        </article>
      )
    )
  }
</div>
