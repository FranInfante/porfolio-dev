---
import Badge from "../components/Badge.astro";
import Layout from "../layouts/Layout.astro";
import Socials from "../components/Socials.astro";
import LinkedInIcon from "../components/icons/LinkedInIcon.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import MailIcon from "../components/icons/MailIcon.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Briefcase from "../components/icons/Briefcase.astro";
import CodeIcon from "../components/icons/CodeIcon.astro";
import Projects from "../components/Projects.astro";
import ProfileIcon from "../components/icons/ProfileIcon.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
---

<Layout
  title="Fran Infante · Soluciones digitales: webs, apps, automatizaciones e IA"
  description="Fran Infante crea soluciones digitales para empresas: webs, apps móviles, automatizaciones e IA, de la idea a producción con su sociedad RepsDown S.L. Ingeniero de software en Sevilla, en remoto. Digital solutions for businesses: websites, mobile apps, automations and AI."
>
  <main class="px-2">
    <SectionContainer class="py-24 pb-24">
      <img
        class="rounded-full size-[200px] "
        src="/pfp.png"
        alt="Fran Infante"
      />
      <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-white/80 text-lg pb-3">
        <span class="i18n-es">Fran Infante · Ingeniero de software multidisciplinar · Sevilla</span>
        <span class="i18n-en">Fran Infante · Multidisciplinary software engineer · Seville</span>
        <a href="mailto:fjinfantejob@gmail.com" target="_blank" rel="noopener">
          <Badge>
            <span class="i18n-es">Disponible para nuevos proyectos</span>
            <span class="i18n-en">Available for new projects</span>
          </Badge>
        </a>
      </p>
      <h1
        class="text-white text-3xl md:text-4xl lg:text-5xl font-bold pb-4 text-balance max-w-[820px]"
      >
        <span class="i18n-es">Creo soluciones digitales: webs, apps móviles, automatizaciones e IA para empresas.</span>
        <span class="i18n-en">I build digital solutions: websites, mobile apps, automations and AI for businesses.</span>
      </h1>

      <h2 class="text-xl md:text-2xl text-wrap max-w-[720px] text-white/90">
        <span class="i18n-es">
          Escucho el problema de tu negocio y lo convierto en una herramienta que funciona: una web que
          vende, una app que tus clientes usan o una automatización que te ahorra horas cada semana. Con
          mi sociedad, <span class="text-cyan-300">RepsDown S.L.</span>, lo diseño, lo construyo y lo mantengo.
          Hoy llevo tres frentes a la vez, RepsDown, Iberika Telecom y MIGSO-PCUBED, y no me cierro a ningún tipo de
          proyecto: web, móvil, backend, cloud, telefonía o IA.
        </span>
        <span class="i18n-en">
          I listen to your business problem and turn it into a tool that works: a website that sells, an
          app your customers use or an automation that saves you hours every week. With my company,
          <span class="text-cyan-300">RepsDown S.L.</span>, I design it, build it and keep it running.
          Today I run three fronts at once, RepsDown, Iberika Telecom and MIGSO-PCUBED, and I take on any kind of
          software project: web, mobile, backend, cloud, telephony or AI.
        </span>
      </h2>

      <div class="flex flex-wrap gap-3 mt-8">
        <a
          href="mailto:fjinfantejob@gmail.com"
          target="_blank"
          rel="noopener"
          class="rounded-full bg-gradient-to-r from-emerald-400 to-cyan-400 text-slate-900 font-semibold px-5 py-2.5 hover:scale-105 transition"
        >
          <span class="i18n-es">Cuéntame tu proyecto</span>
          <span class="i18n-en">Tell me about your project</span>
        </a>
        <a
          href="#proyectos"
          class="rounded-full border border-white/20 bg-white/5 text-white font-semibold px-5 py-2.5 hover:bg-white/10 hover:scale-105 transition"
        >
          <span class="i18n-es">Ver proyectos</span>
          <span class="i18n-en">See projects</span>
        </a>
      </div>

      <nav class="flex gap-x-4 gap-y-2 mt-6 flex-wrap">
        <Socials href="https://www.linkedin.com/in/franinfante/">
          <LinkedInIcon class="size-4" />
          LinkedIn
        </Socials>
        <Socials href="https://github.com/FranInfante">
          <GithubIcon class="size-4" />
          Github
        </Socials>
        <Socials href="mailto:fjinfantejob@gmail.com">
          <MailIcon class="size-4" />
          fjinfantejob@gmail.com
        </Socials>
      </nav>
    </SectionContainer>

    <SectionContainer id="servicios" class="py-10">
      <h2 class="text-2xl ml-8 font-semibold mb-6 flex gap-x-3 items-center">
        <CodeIcon class="size-8" />
        <span class="i18n-es">Qué hago</span>
        <span class="i18n-en">What I do</span>
      </h2>
      <Services />
    </SectionContainer>

    <SectionContainer id="proyectos" class="py-10">
      <h2 class="text-2xl ml-8 font-semibold mb-6 flex gap-x-3 items-center">
        <CodeIcon class="size-8" />
        <span class="i18n-es">Proyectos</span>
        <span class="i18n-en">Projects</span>
      </h2>
      <Projects />
    </SectionContainer>

    <SectionContainer id="experiencia" class="py-10">
      <h2 class="text-2xl ml-8 font-semibold mb-6 flex gap-x-3 items-center">
        <Briefcase class="size-8" />
        <span class="i18n-es">Experiencia laboral</span>
        <span class="i18n-en">Work experience</span>
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id="aboutme" class="py-10">
      <h2 class="text-2xl font-semibold justify-center flex gap-x-3 items-center">
        <ProfileIcon class="size-8" />
        <span class="i18n-es">Sobre mí</span>
        <span class="i18n-en">About me</span>
      </h2>
      <About />
    </SectionContainer>
  </main>
</Layout>
